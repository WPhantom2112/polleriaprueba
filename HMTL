        .status-done { background: #55efc4; color: #00b894; }

        /* DayanaBot Widget */
        .bot-widget {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1001;
        }

        .bot-button {
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bot-window {
            display: none;
            position: absolute;
            bottom: 70px;
            right: 0;
            width: 320px;
            height: 400px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            flex-direction: column;
            overflow: hidden;
        }

        .bot-header {
            background: var(--primary);
            color: white;
            padding: 1rem;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
        }

        .bot-messages {
            flex-grow: 1;
            padding: 1rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 0.85rem;
        }

        .msg-bot {
            background: #f1f0f0;
            padding: 8px 12px;
            border-radius: 10px;
            align-self: flex-start;
            max-width: 80%;
        }

        .msg-user {
            background: var(--primary);
            color: white;
            padding: 8px 12px;
            border-radius: 10px;
            align-self: flex-end;
            max-width: 80%;
        }

        .bot-input {
            display: flex;
            border-top: 1px solid #ddd;
        }

        .bot-input input {
            flex-grow: 1;
            border: none;
            padding: 0.8rem;
            outline: none;
        }

        .bot-input button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0 1rem;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-drumstick-bite"></i> Pollería Dayana
        </div>
        <nav>
            <ul>
                <li><a href="#menu">Menú</a></li>
                <li><a href="#promos">Promociones</a></li>
                <li><a href="#pedidos-panel">Panel de Control</a></li>
            </ul>
        </nav>
        <div class="cart-icon" onclick="document.getElementById('cart').scrollIntoView();">
            <i class="fa-solid fa-cart-shopping"></i>
            <span class="cart-badge" id="cart-count">0</span>
        </div>
    </header>

    <!-- Hero Banner -->
    <div class="hero">
        <h1>El Tradicional Sabor a la Brasa</h1>
        <p>Pide online fácil, rápido y recíbelo directo en tu mesa o domicilio.</p>
        <button class="btn-hero" onclick="document.getElementById('menu').scrollIntoView();">Ver Menú Completo</button>
    </div>

    <!-- Main Content -->
    <div class="container">
        <!-- Products Column -->
        <div>
            <h2 class="section-title" id="menu">Nuestros Platos Principales</h2>
            <div class="menu-grid">
                <!-- Item 1 -->
                <div class="card">
                    <img src="https://images.unsplash.com/photo-1598515214211-89d3c73ae83b?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" alt="Pollo Entero">
                    <div class="card-body">
                        <div class="card-title">1 Pollo a la Brasa</div>
                        <div class="card-desc">Con papas fritas familiares, ensalada fresca y cremas.</div>
                        <div class="card-footer">
                            <span class="price">S/ 65.00</span>
                            <button class="btn-add" onclick="addToCart('1 Pollo a la Brasa', 65)">+ Agregar</button>
                        </div>
                    </div>
                </div>
                <!-- Item 2 -->
                <div class="card">
                    <img src="https://images.unsplash.com/photo-1626645738196-c2a7c87a8f58?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" alt="1/2 Pollo">
                    <div class="card-body">
                        <div class="card-title">1/2 Pollo a la Brasa</div>
                        <div class="card-desc">Con papas fritas, ensalada personal y cremas.</div>
                        <div class="card-footer">
                            <span class="price">S/ 35.00</span>
                            <button class="btn-add" onclick="addToCart('1/2 Pollo a la Brasa', 35)">+ Agregar</button>
                        </div>
                    </div>
                </div>
                <!-- Item 3 -->
                <div class="card">
                    <img src="https://images.unsplash.com/photo-1562967914-608f82629710?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" alt="1/4 Pollo">
                    <div class="card-body">
                        <div class="card-title">1/4 Pollo a la Brasa</div>
                        <div class="card-desc">Pierna o Pecho con papas fritas y ensalada.</div>
                        <div class="card-footer">
                            <span class="price">S/ 20.00</span>
                            <button class="btn-add" onclick="addToCart('1/4 Pollo a la Brasa', 20)">+ Agregar</button>
                        </div>
                    </div>
                </div>
                <!-- Item 4 -->
                <div class="card">
                    <img src="https://images.unsplash.com/photo-1544025162-d76694265947?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80" alt="Parrillada">
                    <div class="card-body">
                        <div class="card-title">Combo Familiar Dayana</div>
                        <div class="card-desc">1 Pollo entero + Gaseosa 1.5L + Porción Tequeños.</div>
                        <div class="card-footer">
                            <span class="price">S/ 78.00</span>
                            <button class="btn-add" onclick="addToCart('Combo Familiar Dayana', 78)">+ Agregar</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Admin Status Control (RF-002) -->
            <div class="admin-section" id="pedidos-panel">
                <h2 class="section-title">Panel de Control de Pedidos (Caja / Atención)</h2>
                <p style="font-size: 0.85rem; color: var(--gray);">Gestión de estados para reflejar al cliente en tiempo real.</p>
                <table class="order-table">
                    <thead>
                        <tr>
                            <th>N° Orden</th>
                            <th>Cliente</th>
                            <th>Detalle</th>
                            <th>Estado Actual</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody id="admin-orders-list">
                        <tr>
                            <td>#ORD-101</td>
                            <td>Carlos Ramos</td>
                            <td>1 Pollo Entero (Papas crujientes)</td>
                            <td><span class="badge-status status-prep" id="st-101">En preparación</span></td>
                            <td>
                                <select onchange="updateStatus('101', this.value)">
                                    <option value="prep">En preparación</option>
                                    <option value="way">En camino</option>
                                    <option value="done">Entregado</option>
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sidebar / Cart (RF-001) -->
        <div class="cart-panel" id="cart">
            <h3><i class="fa-solid fa-basket-shopping"></i> Tu Carrito</h3>
            <ul class="cart-items" id="cart-items-list">
                <p style="font-size: 0.85rem; color: var(--gray);">Tu carrito está vacío.</p>
            </ul>
            
            <textarea class="notes-area" id="order-notes" rows="2" placeholder="Notas especiales (ej: papas crujientes, sin mayonesa)..."></textarea>

            <div class="cart-total">
                <span>Total:</span>
                <span id="cart-total-price">S/ 0.00</span>
            </div>

            <button class="btn-checkout" onclick="checkout()">Confirmar Pedido</button>
        </div>
    </div>

    <!-- DayanaBot Widget (RF-003) -->
    <div class="bot-widget">
        <div class="bot-window" id="bot-window">
            <div class="bot-header">
                <span><i class="fa-solid fa-robot"></i> DayanaBot</span>
                <span style="cursor:pointer;" onclick="toggleBot()">✕</span>
            </div>
            <div class="bot-messages" id="bot-messages">
                <div class="msg-bot">¡Hola! Soy DayanaBot 🤖. ¿En qué puedo ayudarte? Puedes preguntarme por el menú, promociones o el estado de tu pedido.</div>
            </div>
            <div class="bot-input">
                <input type="text" id="bot-text" placeholder="Escribe tu consulta..." onkeypress="handleBotKey(event)">
                <button onclick="sendBotMsg()">Enviar</button>
            </div>
        </div>
        <button class="bot-button" onclick="toggleBot()">
            <i class="fa-solid fa-comments"></i>
        </button>
    </div>

    <!-- Interactivity Script -->
    <script>
        let cart = [];
        let total = 0;
        let orderCount = 102;

        function addToCart(name, price) {
            cart.push({ name, price });
            total += price;
            updateCartUI();
        }

        function updateCartUI() {
            const list = document.getElementById('cart-items-list');
            const count = document.getElementById('cart-count');
            const totalPrice = document.getElementById('cart-total-price');

            count.innerText = cart.length;
            totalPrice.innerText = `S/ ${total.toFixed(2)}`;

            if (cart.length === 0) {
                list.innerHTML = '<p style="font-size: 0.85rem; color: var(--gray);">Tu carrito está vacío.</p>';
                return;
            }

            list.innerHTML = '';
            cart.forEach((item, index) => {
                list.innerHTML += `
                    <li class="cart-item">
                        <span>${item.name}</span>
                        <span><b>S/ ${item.price.toFixed(2)}</b></span>
                    </li>
                `;
            });
        }

        function checkout() {
            if (cart.length === 0) {
                alert("Por favor, agrega al menos un plato a tu carrito.");
                return;
            }

            const notes = document.getElementById('order-notes').value;
            const orderId = `#ORD-${orderCount}`;
            const details = cart.map(i => i.name).join(', ') + (notes ? ` (${notes})` : '');

            // Add to admin panel table
            const tbody = document.getElementById('admin-orders-list');
            tbody.innerHTML += `
                <tr>
                    <td>${orderId}</td>
                    <td>Cliente Web</td>
                    <td>${details}</td>
                    <td><span class="badge-status status-prep" id="st-${orderCount}">En preparación</span></td>
                    <td>
                        <select onchange="updateStatus('${orderCount}', this.value)">
                            <option value="prep">En preparación</option>
                            <option value="way">En camino</option>
                            <option value="done">Entregado</option>
                        </select>
                    </td>
                </tr>
            `;

            alert(`¡Pedido ${orderId} registrado con éxito! Puedes consultar su estado con DayanaBot.`);
            
            // Reset Cart
            cart = [];
            total = 0;
            document.getElementById('order-notes').value = '';
            updateCartUI();
            orderCount++;
        }

        function updateStatus(id, value) {
            const badge = document.getElementById(`st-${id}`);
            if (value === 'prep') {
                badge.className = 'badge-status status-prep';
                badge.innerText = 'En preparación';
            } else if (value === 'way') {
                badge.className = 'badge-status status-way';
                badge.innerText = 'En camino';
            } else if (value === 'done') {
                badge.className = 'badge-status status-done';
                badge.innerText = 'Entregado';
            }
        }

        // Chatbot functions
        function toggleBot() {
            const win = document.getElementById('bot-window');
            win.style.display = win.style.display === 'flex' ? 'none' : 'flex';
        }

        function handleBotKey(e) {
            if (e.key === 'Enter') sendBotMsg();
        }

        function sendBotMsg() {
            const input = document.getElementById('bot-text');
            const msg = input.value.trim();
            if (!msg) return;

            const chat = document.getElementById('bot-messages');
            chat.innerHTML += `<div class="msg-user">${msg}</div>`;
            input.value = '';

            setTimeout(() => {
                let reply = "Lo siento, no entendí tu consulta. Prueba preguntando por 'menú', 'horarios' o ingresando tu número de pedido (ej: #ORD-101).";
                const lower = msg.toLowerCase();

                if (lower.includes('menu') || lower.includes('platos') || lower.includes('precios')) {
                    reply = "Ofrecemos 1 Pollo a la Brasa (S/ 65), 1/2 Pollo (S/ 35), 1/4 Pollo (S/ 20) y Combos Familiares. ¡Puedes agregarlos directo al carrito!";
                } else if (lower.includes('horario') || lower.includes('atencion')) {
                    reply = "Atendemos de Lunes a Domingo de 12:00 PM a 10:30 PM en Cusco.";
                } else if (lower.includes('ord-101') || lower.includes('101')) {
                    const statusText = document.getElementById('st-101').innerText;
                    reply = `El estado actual de la orden #ORD-101 es: **${statusText}**.`;
                } else if (lower.includes('ord-102') || lower.includes('102')) {
                    const badge = document.getElementById('st-102');
                    const statusText = badge ? badge.innerText : 'En preparación';
                    reply = `El estado actual de la orden #ORD-102 es: **${statusText}**.`;
                }

                chat.innerHTML += `<div class="msg-bot">${reply}</div>`;
                chat.scrollTop = chat.scrollHeight;
            }, 500);
        }
    </script>
</body>
</html>
